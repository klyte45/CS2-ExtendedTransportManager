{
  "compilerOptions": {
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "isolatedModules": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "src",
    "skipLibCheck": true,
    "typeRoots": [
      "./types"
    ],
    "resolveJsonModule": true,
    "paths": {
      "mod.json": [
        "../mod.json"
      ],
      "#components/*": [
        "src/components/*"
      ],
      "#enum/*": [
        "src/enum/*"
      ],
      "#service/*": [
        "src/service/*"
      ],
      "#utility/*": [
        "src/utility/*"
      ],
      "#styles/*": [
        "src/styles/*"
      ],
    }
  }
}